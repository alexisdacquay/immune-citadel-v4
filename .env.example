# Copy to .env (gitignored) to send local telemetry to Dash0. Without it, telemetry is off.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.europe-west4.gcp.dash0.com
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <dash0-auth-token>
# Only for `npm run alert` (creates the alert in Dash0):
DASH0_API_URL=https://api.europe-west4.gcp.dash0.com
DASH0_AUTH_TOKEN=<dash0-auth-token>
